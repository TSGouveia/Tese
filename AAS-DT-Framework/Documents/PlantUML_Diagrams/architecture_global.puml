@startuml architecture_global
!theme plain
left to right direction

skinparam componentStyle uml2
skinparam handwritten false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam arrowThickness 1.5
skinparam arrowColor #334155

skinparam nodesep 90
skinparam ranksep 110

skinparam package {
    BorderThickness 2
    FontColor #0F172A
    FontStyle bold
    FontSize 12
    Padding 16
}

skinparam component {
    BorderThickness 1.5
    FontSize 11
    Padding 10
}

skinparam interface {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    BorderThickness 1.8
    FontSize 10
}

' =============================================================================
' LAYER 0: PHYSICAL ASSET DIGITIZATION (Blender)
' =============================================================================
package "Layer 0 · Asset Digitization\n(Blender 5.2.0 LTS)" as L0 #F8FAFC;line:475569 {
    component [Physical Survey\n(Metric Calipers)] as Comp_Survey #E2E8F0;line:64748B
    component [3D Mesh Modeler\n(Low-Poly Geometry)] as Comp_Blender #E2E8F0;line:64748B
    component [Hierarchy & Pivots\n(Rigging & Alignment)] as Comp_Rigging #E2E8F0;line:64748B
    component [GLB Exporter\n(glTF 2.0 Binary)] as Comp_GLB #CBD5E1;line:475569

    interface "PhysicalDimensions" as IF_Dim
    interface "Raw3DMesh" as IF_Mesh
    interface "RiggedModel" as IF_Rigged

    Comp_Survey -down- IF_Dim
    Comp_Blender -( IF_Dim

    Comp_Blender -down- IF_Mesh
    Comp_Rigging -( IF_Mesh

    Comp_Rigging -down- IF_Rigged
    Comp_GLB -( IF_Rigged
}

interface "VisualAssetModel" as IF_GLB #F8FAFC;line:475569
Comp_GLB -up- IF_GLB

' =============================================================================
' LAYER 1: ASSET MODELING (Conveyor Wizard)
' =============================================================================
package "Layer 1 · Asset Modeling\n(Conveyor Wizard Suite)" as L1 #EFF6FF;line:1D4ED8 {
    component [Authoring GUI & Orchestrator\n(PyQt6 / QMainWindow)] as Comp_Wizard #DBEAFE;line:2563EB
    component [3D Viewport & Raycaster\n(PyVista / Trimesh)] as Comp_Raycast #DBEAFE;line:2563EB
    component [Pin & Logic Mapper\n(VirtualPins & ControlLogic)] as Comp_PinMapper #DBEAFE;line:2563EB
    component [BaSyx Python SDK\n(AASX Builder)] as Comp_PySDK #BFDBFE;line:1D4ED8

    interface "SurfacePicking" as IF_Picking
    interface "PinConfiguration" as IF_PinConfig
    interface "SubmodelMetadata" as IF_SMData
    interface "AASXPackage" as IF_AASXPkg #EFF6FF;line:1D4ED8

    Comp_Raycast -down- IF_Picking
    Comp_Wizard -( IF_Picking

    Comp_Wizard -down- IF_PinConfig
    Comp_PinMapper -( IF_PinConfig

    Comp_PinMapper -down- IF_SMData
    Comp_PySDK -( IF_SMData

    Comp_PySDK -right- IF_AASXPkg
}

Comp_Wizard -( IF_GLB

' =============================================================================
' LAYER 2: STORAGE AND REGISTRY (Eclipse BaSyx v2 on Docker)
' =============================================================================
package "Layer 2 · Storage & Registry\n(Eclipse BaSyx v2 Docker)" as L2 #F0FDF4;line:15803D {
    component [AAS Environment Repository\n(:8081 · Model Server)] as Comp_AASRepo #DCFCE7;line:16A34A
    component [AAS Registry\n(:8082 · Shell Directory)] as Comp_AASReg #DCFCE7;line:16A34A
    component [Submodel Registry\n(:8083 · Submodel Directory)] as Comp_SMReg #DCFCE7;line:16A34A
    component [MongoDB Database\n(:27017 · Metadata Store)] as Comp_Mongo #FED7AA;line:EA580C
    component [BaSyx Web UI\n(:3000 · Dashboard)] as Comp_BaSyxUI #F3E8FF;line:9333EA

    ' Ingestion & Persistence
    interface "AASXPackageUpload" as IF_Upload #F0FDF4;line:15803D
    interface "DocumentStorage" as IF_Mongo #FFF7ED;line:EA580C

    ' Dedicated Registration APIs (consumed by Python SDK)
    interface "AASRegistrationAPI" as IF_AASRegPub #F0FDF4;line:15803D
    interface "SubmodelRegistrationAPI" as IF_SMRegPub #F0FDF4;line:15803D

    ' Dedicated Discovery & Read APIs (consumed by Unity)
    interface "AASDiscoveryAPI" as IF_AASDisc #F0FDF4;line:15803D
    interface "SubmodelLookupAPI" as IF_SMLookup #F0FDF4;line:15803D
    interface "SubmodelReadAPI" as IF_SMRead #F0FDF4;line:15803D

    ' Dedicated UI APIs (consumed by BaSyx Web UI)
    interface "AASCatalogAPI" as IF_AASCatalog #F0FDF4;line:15803D
    interface "SubmodelBrowseAPI" as IF_SMBrowse #F0FDF4;line:15803D

    Comp_AASRepo -left- IF_Upload
    Comp_AASRepo -right- IF_SMRead
    Comp_AASRepo -down- IF_SMBrowse

    Comp_AASReg -left- IF_AASRegPub
    Comp_AASReg -right- IF_AASDisc
    Comp_AASReg -down- IF_AASCatalog

    Comp_SMReg -left- IF_SMRegPub
    Comp_SMReg -right- IF_SMLookup

    Comp_Mongo -up- IF_Mongo

    ' BaSyx Internal Links
    Comp_AASReg -( IF_Mongo
    Comp_SMReg -( IF_Mongo
    Comp_AASRepo -( IF_Mongo

    Comp_BaSyxUI -( IF_AASCatalog
    Comp_BaSyxUI -( IF_SMBrowse
}

' Layer 1 -> Layer 2 Links (Publication)
Comp_PySDK -( IF_Upload
Comp_PySDK -( IF_AASRegPub
Comp_PySDK -( IF_SMRegPub

' =============================================================================
' LAYER 3: RUNTIME EXECUTION & SYNCHRONIZATION
' =============================================================================
package "Layer 3 · Runtime Execution & Synchronization" as L3 #FAF5FF;line:6D28D9 {
    
    package "Unity 3D Simulation (C# / PhysX)" as Comp_UnityEnv #F5F3FF;line:7C3AED {
        package "Scene Singletons" as Pkg_Mgrs #EDE9FE;line:6D28D9 {
            component [BaSyxManager.cs\n(AAS Loader)] as Comp_BM #DDD6FE;line:6D28D9
            component [OperationModeManager.cs\n(Mode Switcher)] as Comp_ModeMgr #DDD6FE;line:6D28D9
            component [AASArduinoLink.cs\n(TCP Client)] as Comp_TCPClient #DDD6FE;line:6D28D9
        }

        package "Asset Controllers" as Pkg_Controllers #EDE9FE;line:7C3AED {
            component [AASKitImporter.cs\n(Scene Builder)] as Comp_Importer #EDE9FE;line:7C3AED
            component [AASSensorController.cs\n(Input Pins)] as Comp_SensCtrl #EDE9FE;line:7C3AED
            component [AASActuatorController.cs\n(Output Pins)] as Comp_ActCtrl #EDE9FE;line:7C3AED
            component [AASRuleEngine.cs\n(Virtual Rules)] as Comp_RuleEngine #EDE9FE;line:7C3AED
        }

        package "PhysX Dynamics" as Pkg_Physics #EDE9FE;line:7C3AED {
            component [DynamicProduct.cs\n(Position Snapping)] as Comp_Snapping #EDE9FE;line:7C3AED
        }

        interface "SceneGraphBuilder" as IF_SceneBuilder
        interface "SensorEventTrigger" as IF_SensEvents
        interface "ActuatorCommand" as IF_ActControl
        interface "DriftCorrection" as IF_Drift

        Comp_BM -right- IF_SceneBuilder
        Comp_Importer -( IF_SceneBuilder

        Comp_SensCtrl -right- IF_SensEvents
        Comp_Importer -( IF_SensEvents

        Comp_ActCtrl -right- IF_ActControl
        Comp_Importer -( IF_ActControl

        Comp_Snapping -right- IF_Drift
        Comp_SensCtrl -( IF_Drift

        Comp_RuleEngine -( IF_ActControl
        Comp_ModeMgr -( IF_SensEvents
    }

    package "Physical Automation Bench" as Comp_FMS #FEF2F2;line:B91C1C {
        component [Sensor Array\n(Breakbeams)] as Comp_Sensors #FECACA;line:EF4444
        component [Optocoupled Rack\n(PC817 24V/5V)] as Comp_Opto #FEE2E2;line:DC2626
        component [Arduino Mega 2560\n(FreeRTOS Firmware)] as Comp_Arduino #FEE2E2;line:DC2626
        component [Actuator Array\n(Motors & Relays)] as Comp_Actuators #FECACA;line:EF4444

        interface "FieldSensorSignal" as IF_FieldIn
        interface "OptoIsolatedLogic" as IF_IsoIn
        interface "ActuatorDriverPower" as IF_Relays

        Comp_Sensors -down- IF_FieldIn
        Comp_Opto -( IF_FieldIn

        Comp_Opto -down- IF_IsoIn
        Comp_Arduino -( IF_IsoIn

        Comp_Arduino -down- IF_Relays
        Comp_Actuators -( IF_Relays

        interface "LiveSensorTelemetry" as IF_ArduinoTCP #FEF2F2;line:DC2626
        interface "PhysicalSkillExecution" as IF_ArduinoHTTP #FEF2F2;line:DC2626
        
        Comp_Arduino -up- IF_ArduinoTCP
        Comp_Arduino -up- IF_ArduinoHTTP
    }

    ' Unity -> BaSyx Discovery & Read Links
    Comp_BM -( IF_AASDisc
    Comp_BM -( IF_SMLookup
    Comp_BM -( IF_SMRead

    ' Unity -> Arduino Mega Physical Telemetry & Control Links
    Comp_TCPClient -( IF_ArduinoTCP
    Comp_ModeMgr -( IF_ArduinoHTTP
}

@enduml
