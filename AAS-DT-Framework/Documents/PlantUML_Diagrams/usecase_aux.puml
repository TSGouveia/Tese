@startuml
top to bottom direction
scale 2.0
skinparam dpi 300
skinparam defaultFontName "Arial"
skinparam defaultFontSize 17
skinparam packageStyle rectangle
skinparam shadowing false
skinparam padding 10
skinparam nodesep 30
skinparam ranksep 40

skinparam usecase {
    BackgroundColor #FCE7F3
    BorderColor #DB2777
    FontColor #500724
    FontSize 17
    FontStyle bold
}

skinparam actor {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontColor #713F12
    FontSize 17
    FontStyle bold
}

skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    FontColor #1E293B
    FontSize 19
    FontStyle bold
}

actor "Automation Engineer" as Eng

rectangle "Auxiliary Operations" {
    usecase "Manage Deployed AAS List" as UCA1
    usecase "Preview Deployed Layout 3D Scene" as UCA2
    usecase "Program Deployed AAS Rules" as UCA3

    UCA1 -[hidden]down-> UCA2
    UCA2 -[hidden]down-> UCA3
}

actor "BaSyx AAS Repository" as BaSyxRepo

Eng --> UCA1
Eng --> UCA2
Eng --> UCA3

UCA1 -down-> BaSyxRepo : "GET / DELETE /shells"
UCA3 -down-> BaSyxRepo : "GET & PUT /submodels"
@enduml





