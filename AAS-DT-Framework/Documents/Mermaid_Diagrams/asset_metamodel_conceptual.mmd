flowchart TB
%% =========================================================================
%% CONCEPTUAL ASSET METAMODEL — 100% TECHNOLOGY AGNOSTIC (CHAPTER 3)
%% =========================================================================

    subgraph ASSET_ROOT["<b>Digital Twin Asset Descriptor</b> (Conceptual Metamodel Root)"]
        direction LR
        ROOT_ID["<b>Asset Identifier:</b> urn:asset:&lt;AssetName&gt;<br/><b>Asset Information:</b> Kind = INSTANCE • GlobalAssetUID = urn:uuid:..."]:::root
    end

    subgraph SUBMODELS["<b>Modular Semantic Facet Descriptors</b>"]
        direction TB

        subgraph ROW1["Geometric, Spatial & Communication Facets"]
            direction LR
            SM_AID["<b>Network Interface Descriptor</b><br/>• Protocol Class: Streaming | RPC | PubSub<br/>• Host Address & Port Binding<br/>• Service Schema & Endpoints"]:::sm
            
            SM_VIS["<b>Visual & Geometric Structure</b><br/>• 3D Geometry Resource Reference<br/>• Kinematic Hierarchy & Parent Node<br/>• Spatial Pose: Translation & Rotation"]:::sm
        end

        subgraph ROW2["Electrical I/O, Behavior & Control Facets"]
            direction LR
            SM_VP["<b>Virtual Coupling Pins (I/O)</b><br/>• Input Pins: Sensor Signals & Breakbeams<br/>• Output Pins: Actuator Drives & Relays<br/>• Data Type: Digital Boolean | Analog State"]:::sm

            SM_BM["<b>Kinematic & Behavioral Mapping</b><br/>• Pin ID & Target Joint/Surface Binding<br/>• Kinematic Behavior: Conveyance | Diverter | Trigger<br/>• Parameters: Surface Speed, Rotation Axis, Logic Inversion"]:::sm

            SM_CL["<b>Autonomous Control Logic</b><br/>• Event Trigger: Source Asset & Source Pin<br/>• Evaluation Condition (==, !=, &gt;, &lt;) & Threshold<br/>• Action Target: Target Pin, Output Value, Transition Delay"]:::sm
        end
    end

    ASSET_ROOT ==>|"Aggregates Semantic Facets"| SUBMODELS

    %% Styling
    classDef root fill:#1e293b,stroke:#0f172a,stroke-width:2.5px,color:#f8fafc,font-size:16px
    classDef sm   fill:#f0f9ff,stroke:#0284c7,stroke-width:2px,color:#0c4a6e,font-size:15px

    style ASSET_ROOT fill:#f8fafc,stroke:#334155,stroke-width:2.5px
    style SUBMODELS fill:#ffffff,stroke:#0284c7,stroke-width:2px
    style ROW1 fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px
    style ROW2 fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px

