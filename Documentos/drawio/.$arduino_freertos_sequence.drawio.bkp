        <mxCell id="m3" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#000000;fontSize=17;fontStyle=1;" value="Start Dual Ethernet Servers (Port 80: HTTP REST, Port 8888: TCP Socket)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="280" as="sourcePoint" />
            <mxPoint x="1160" y="280" as="targetPoint" />
          </mxGeometry>
