        <mxCell id="m10" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#000000;fontSize=17;fontStyle=1;" value="Dispatch Compact Telemetry Event Packet over TCP Socket Stream (:8888)">
