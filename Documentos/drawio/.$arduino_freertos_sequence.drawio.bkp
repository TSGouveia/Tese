        <mxCell id="m2" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#000000;fontSize=17;fontStyle=1;" value="Create FreeRTOS IPC Primitives (Queue: envio [30 elements], mutex_envio)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="235" as="sourcePoint" />
            <mxPoint x="660" y="235" as="targetPoint" />
          </mxGeometry>
