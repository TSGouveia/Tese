        <!-- MESSAGES: PHASE 1 -->
        <mxCell id="m1" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=17;" value="Initialize GPIO Pin Modes (Inputs: I0..I2, Outputs: R0..R2)">
