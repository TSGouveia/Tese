        <mxCell id="m4" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#000000;fontSize=17;fontStyle=1;" value="Spawn Concurrent FreeRTOS Tasks (TaskSensores [P3], TaskEnvio [P2], TaskDigitalshadow [P1], TaskTripa [P1])">
