          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="555" as="sourcePoint" />
            <mxPoint x="660" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m8" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#000000;fontSize=17;fontStyle=1;" value="xQueueReceive(envio, &amp;data, portMAX_DELAY) [Unblock TaskEnvio]">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="600" as="sourcePoint" />
            <mxPoint x="910" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m9" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=17;" value="Lock mutex_envio &amp; Serialize JSON: {&quot;Port&quot;:&quot;I1_1&quot;,&quot;Value&quot;:1}">
