        <mxCell id="m5" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#000000;fontSize=17;fontStyle=1;" value="Read Sensor Voltage via Optocoupler Board (5ms Periodic Scan Loop)">
