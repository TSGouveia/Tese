        <mxCell id="m6" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=17;" value="Apply Software Debounce &amp; Detect Pin Edge Change (Rising/Falling)">
          <mxGeometry relative="1" x="-0.2632" y="120" as="geometry">
