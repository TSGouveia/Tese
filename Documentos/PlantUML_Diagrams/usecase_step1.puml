@startuml
top to bottom direction
scale 2.0
skinparam dpi 300
skinparam defaultFontName "Arial"
skinparam defaultFontSize 17
skinparam packageStyle rectangle
skinparam shadowing false
skinparam padding 10
skinparam nodesep 30
skinparam ranksep 40

skinparam usecase {
    BackgroundColor #E0F2FE
    BorderColor #0284C7
    FontColor #0C4A6E
    FontSize 17
    FontStyle bold
}

skinparam actor {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontColor #713F12
    FontSize 17
    FontStyle bold
}

skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    FontColor #1E293B
    FontSize 19
    FontStyle bold
}

actor "Automation Engineer" as Eng

rectangle "Step 1: Model Selection" {
    usecase "Select GLB 3D Asset File" as UC1A
    usecase "Select URDF Package Folder" as UC1B
    usecase "Preview 3D Model in Viewer" as UC1C
    usecase "Browse Node Hierarchy Tree" as UC1D

    UC1A -[hidden]down-> UC1B
    UC1B -[hidden]down-> UC1C
    UC1C -[hidden]down-> UC1D

    UC1A ..> UC1C : <<include>>
    UC1B ..> UC1C : <<include>>
    UC1C ..> UC1D : <<include>>
}

Eng --> UC1A
Eng --> UC1B
@enduml





