flowchart TB
%% =========================================================================
%% ARDUINO FREERTOS ARCHITECTURE â€” ULTRA-LEGIBLE EDITION
%% =========================================================================

    subgraph HW["<b>1. Physical I/O & Microcontroller Hardware</b> (Arduino Mega 2560)"]
        direction LR
        SENS["<b>Sensor Array (Port I)</b><br/>Inputs I0_0 .. I2_5 (Optical/Inductive)"]:::a_hw
        ACTS["<b>Actuator Array (Port R)</b><br/>Outputs R0_2 .. R2_8 (Motors/Relays)"]:::a_hw
        W5100["<b>W5100 Ethernet Shield</b><br/>IP: 192.168.10.1 (SPI Bus)"]:::a_hw
    end

    subgraph RTOS["<b>2. FreeRTOS Preemptive Kernel & Inter-Process Communication</b>"]
        direction TB

        subgraph TASKS["Concurrent Real-Time FreeRTOS Tasks"]
            direction LR
            TS["<b>TaskSensores</b><br/>Scan I0..I2 & Edge Detection"]:::a_task
            TE["<b>TaskEnvio</b><br/>JSON Formatting & TCP Stream"]:::a_task
            TDS["<b>TaskDigitalshadow</b><br/>Session Monitor (:8888)"]:::a_task
            TT["<b>TaskTripa</b><br/>HTTP REST Server (:80)"]:::a_task
        end

        subgraph IPC["IPC Synchronization"]
            direction LR
            Q_ENV[("<b>Queue: envio</b><br/>Buffer: 30 items")]:::a_ipc
            MUTEX[("<b>mutex_envio</b><br/>SemaphoreMutex")]:::a_ipc
            STATE[("<b>Shared State</b><br/>porto_I & porto_R")]:::a_ipc
        end

        TS -->|"Push Event"| Q_ENV
        Q_ENV -->|"Pop Event"| TE
        TE -.->|"Lock"| MUTEX
        TS <--> STATE
        TT <--> STATE
    end

    subgraph NET["<b>3. Industrial Communication Peers</b>"]
        direction LR
        UNITY["<b>Unity 3D Engine Client</b><br/>TCP Socket :8888 (Low-Latency Stream)"]:::a_net
        BASYX["<b>BaSyx / MES Client</b><br/>HTTP REST :80 (Skill Requests)"]:::a_net
    end

    %% Field Links
    SENS ==>|"digitalRead()"| TS
    TT ==>|"digitalWrite()"| ACTS
    W5100 <==> TASKS
    TE ==>|"Stream JSON: {'Port':'I1_1','Value':1}"| UNITY
    BASYX ==>|"HTTP GET /passadeiras"| TT

    %% Styling with massive font and thick borders
    classDef a_hw   fill:#fee2e2,stroke:#b91c1c,stroke-width:2.5px,color:#0f172a,font-size:18px
    classDef a_task fill:#dbeafe,stroke:#1d4ed8,stroke-width:2.5px,color:#0f172a,font-size:18px
    classDef a_ipc  fill:#fef3c7,stroke:#b45309,stroke-width:2.5px,color:#0f172a,font-size:18px
    classDef a_net  fill:#ede9fe,stroke:#6d28d9,stroke-width:2.5px,color:#0f172a,font-size:18px

    style HW fill:#fef2f2,stroke:#dc2626,stroke-width:2.5px
    style RTOS fill:#f0fdf4,stroke:#15803d,stroke-width:3px
    style TASKS fill:#ffffff,stroke:#86efac,stroke-width:1.5px
    style IPC fill:#ffffff,stroke:#fde68a,stroke-width:1.5px
    style NET fill:#ffffff,stroke:#c084fc,stroke-width:2.5px

