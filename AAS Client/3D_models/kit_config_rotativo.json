{
  "kit_name": "RotationalConveyorV9",
  "aas_id": "RotationalConveyor_V9",
  "description": "Conveyor rotativo com limites Rotate 0 e Rotate 90 e correias paralelas.",
  "components": [
    {
      "name": "ConveyorSystem",
      "mesh": "Rotativo.glb",
      "parent": null,
      "position": [9, 0, 0],
      "scale": [0.5, 0.5, 0.5],
      "actuators": [
        {
          "pin_id": "OUT_Rotate_CW",
          "node": "Rotator",
          "behavior": "RotateContinuous",
          "axis": [0, 0, -1],
          "speed": 0.5,
          "stop_sensor": "IN_Rotate_90"
        },
        {
          "pin_id": "OUT_Rotate_ACW",
          "node": "Rotator",
          "behavior": "RotateContinuous",
          "axis": [0, 0, 1],
          "speed": 0.5,
          "stop_sensor": "IN_Rotate_0"
        },
        {
          "pin_id": "OUT_Belts_Run",
          "node": "Belt",
          "behavior": "Conveyor",
          "axis": [1, 0, 0],
          "speed": 1.0
        },
        {
          "pin_id": "OUT_Belts_Run",
          "node": "Belt1",
          "behavior": "Conveyor",
          "axis": [1, 0, 0],
          "speed": 1.0
        }
      ],
      "sensors": [
        {
          "pin_id": "IN_Rotate_0",
          "node": "Rotate 0",
          "behavior": "TriggerZone",
          "target_filter": "Ativador",
          "visible": false
        },
        {
          "pin_id": "IN_Rotate_90",
          "node": "Rotate 90",
          "behavior": "TriggerZone",
          "target_filter": "Ativador",
          "visible": false
        },
        {
          "pin_id": "IN_Product_Detected",
          "node": "TriggerZone",
          "behavior": "TriggerZone",
          "target_filter": "Product",
          "visible": false
        }
      ]
    }
  ]
}
