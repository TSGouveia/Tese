%% =========================================================================

    subgraph MANAGERS["<b>1. Core System Singletons & Communication</b>"]
        direction LR
        BSM["<b>BaSyxManager.cs</b><br/>AAS Discovery & REST Client"]:::u_mgr
        OPM["<b>OperationModeManager.cs</b><br/>Virtual Comm vs Digital Twin"]:::u_mgr
        LNK["<b>AASArduinoLink.cs</b><br/>TCP Socket Client (:8888)"]:::u_mgr
        UI["<b>ModeUIController.cs</b><br/>Screen Mode Toggle UI"]:::u_mgr
    end

    subgraph ASSETS["<b>2. Procedural AAS GameObjects (Runtime Ingestion)</b>"]
        direction TB

        subgraph CONV["Conveyor System Kit (AASKitImporter.cs)"]
            direction LR
            MESH["<b>3D Mesh Hierarchy</b><br/>Base, Belt & Stopper Links"]:::u_comp
            S_CTRL["<b>AASSensorController</b><br/>Colliders & Pin Inputs (Port I)"]:::u_comp
            A_CTRL["<b>AASActuatorController</b><br/>Conveyor Belt & Gate Relays (Port R)"]:::u_comp
            R_ENG["<b>AASRuleEngine</b><br/>Event-Driven Control Logic"]:::u_comp

            MESH --> S_CTRL --> R_ENG --> A_CTRL
        end

        subgraph ROBOT["Robotic Arm Twin (AASUrdfImporter.cs)"]
            direction LR
            ARM["<b>URDF Articulation Chain</b><br/>Kinematic Joints & Meshes"]:::u_rob
            SYNC["<b>AASRobotSync.cs</b><br/>LiveJoints Angle Telemetry"]:::u_rob
            ARM <--> SYNC
        end
    end

    subgraph PRODS["<b>3. Dynamic Products & Physics Layer (PhysX)</b>"]
        direction LR
        DP["<b>DynamicProduct.cs (Pallets & Workpieces)</b><br/>- Rigidbody Physics & Belt Velocity Advection<br/>- Smooth Lerp Snapping on Physical Hardware Sensor Events"]:::u_prod
    end

    %% Bindings
    BSM ==>|"Instantiates Assets Procedurally"| ASSETS
    LNK ==>|"Dispatch Pin Event (I1_1)"| S_CTRL
    LNK ==>|"Trigger Hardware Snap"| DP
    CONV ==>|"PhysX Conveyance"| DP

