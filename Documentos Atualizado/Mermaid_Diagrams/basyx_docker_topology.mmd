flowchart TB
%% =========================================================================
%% BASYX DOCKER TOPOLOGY â€” ULTRA-LEGIBLE EDITION
%% =========================================================================

    subgraph CLIENTS["<b>External Clients & Hardware Endpoints</b>"]
        direction LR
        C_WIZ["<b>Python Wizard</b><br/>AASX Packager"]:::b_c
        C_UNI["<b>Unity 3D Engine</b><br/>Digital Twin Client"]:::b_c
        C_WEB["<b>Web Browser</b><br/>Supervisory GUI"]:::b_c
        C_ARD["<b>Arduino FMS</b><br/>Hardware Bench"]:::b_c
    end

    subgraph DOCKER["<b>Eclipse BaSyx v2 Docker Host (Bridge Network)</b>"]
        direction TB

        subgraph CORE["Core Industrial Digital Twin Microservices"]
            direction LR
            ENV["<b>aas-env (:8081)</b><br/>AAS/SM Repository Â· /upload"]:::b_core
            REG["<b>aas-registry (:8082)</b><br/>Shell Descriptors"]:::b_core
            SMREG["<b>sm-registry (:8083)</b><br/>Submodel Directory"]:::b_core
            UI["<b>aas-ui (:3000)</b><br/>BaSyx Web Interface"]:::b_core
        end

        subgraph DATA["Persistence, Event Broker & Metrics"]
            direction LR
            MONGO[("<b>mongo (:27017)</b><br/>Registries Store")]:::b_db
            MOSQ["<b>mosquitto (:1883)</b><br/>MQTT Event Broker"]:::b_core
            INFLUX[("<b>influxdb (:8086)</b><br/>Time-Series Historian")]:::b_db
            DASH["<b>dashboard-api (:8085)</b><br/>Analytics Service"]:::b_core
        end

        REG & SMREG & DASH -->|"TCP :27017"| MONGO
        ENV <-->|"MQTT :1883"| MOSQ
        ENV -.->|"Telemetry"| INFLUX
        UI -.->|"Query Shells"| REG & SMREG & ENV
    end

    %% Client Links
    C_WIZ ==>|"POST /upload & Descriptors"| ENV
    C_UNI <==>|"GET /shells & /submodels"| ENV
    C_UNI -.->|"MQTT Telemetry"| MOSQ
    C_WEB ==>|"HTTP :3000"| UI
    C_ARD -.->|"REST Skills :80"| ENV

    %% Styling with massive font and bold borders
    classDef b_c    fill:#f1f5f9,stroke:#334155,stroke-width:2.5px,color:#0f172a,font-size:20px
