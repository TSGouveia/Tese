sequenceDiagram
    autonumber
    %% =========================================================================
    %% DUAL-MODE SEQUENCE — TECHNOLOGY AGNOSTIC (CHAPTER 3)
    %% =========================================================================

    box rgb(239, 246, 255) "Mode A: Virtual Commissioning (Physics & Local Rule Engine)"
        participant PH as Physics Solver
        participant VS as Virtual Sensor
        participant RE as Rule Engine
        participant VA as Virtual Actuator
    end

    Note over PH, VA: MODE A: Autonomous Physics & Simulation
    PH->>VS: 1. Workpiece trips Virtual Collider
    activate VS
    VS->>RE: 2. Sensor Event: Pin_I0_1 = True
    deactivate VS
    activate RE
    RE->>RE: 3. Evaluate Configured Rule Table
    RE->>VA: 4. Action: SetPin(Pin_R0_2, True)
    deactivate RE
    activate VA
    VA->>PH: 5. Halt Conveyance & Engage Stopper
    deactivate VA

    box rgb(254, 242, 242) "Mode B: Digital Twin (Physical Hardware Real-Time Sync)"
        participant HW as Physical System
        participant ARD as Edge Controller
        participant LNK as Simulation Client
        participant DT as Digital Workpiece
    end

    Note over HW, DT: MODE B: Real-Time Tracking (Rules Paused)
    HW->>ARD: 6. Physical Workpiece trips Optical Sensor (I1_1)
    activate ARD
    ARD->>ARD: 7. Controller routine captures pin transition
    ARD->>LNK: 8. Deterministic Stream {"Port":"I1_1","Value":1}
    deactivate ARD
    activate LNK
    LNK->>DT: 9. Dispatch Event -> Snap/Lerp Position
    deactivate LNK
    activate DT
    DT->>DT: 10. Synchronize 3D Pose with Physical Station
    deactivate DT

